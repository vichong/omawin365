# Local prototype, NOT submission/release approval. See ../README.md.
pkgname=omawin365-freerdp
pkgver=3.32.1
pkgrel=1
pkgdesc='Private stock FreeRDP provider for OMAWIN365 (SSO and camera client off)'
arch=('x86_64')
url='https://www.freerdp.com/'
license=('Apache-2.0' 'MIT' 'LGPL-2.1-or-later' 'LicenseRef-uwac')
# No provides/replaces/conflicts: distro freerdp remains untouched.
depends=('alsa-lib' 'e2fsprogs' 'ffmpeg' 'fuse3' 'glibc' 'icu' 'jansson'
         'krb5' 'libcups' 'libgcc' 'libice' 'libpulse' 'libsm' 'libusb'
         'libx11' 'libxcursor' 'libxext' 'libxfixes' 'libxi' 'libxinerama'
         'libxkbcommon' 'libxkbfile' 'libxrandr' 'libxrender' 'libxv'
         'openssl' 'pcsclite' 'sndio' 'systemd-libs' 'wayland' 'zlib')
makedepends=('cmake' 'pkgconf' 'python')
_commit=bf217a504e54cc719880c228e82353382cd7d4fa
source=("FreeRDP-$_commit.tar.gz::https://github.com/FreeRDP/FreeRDP/archive/$_commit.tar.gz"
        'configure.sh' 'accepted-features.txt' 'check-contract.py' 'uwac-NOTICES.txt')
sha256sums=('4a25a61f2e81f8d8832634c6d457edc1b48fc76630cf58c06695a27afdbbecca'
            'cf5b269e8d58804fca9aeccb58a1683499df04ba1ddc2b86cfef1bbe4424227e'
            'a22256b9f5f916cbf103eeb4fae8110ebc89c22125437a223a8aea6f7fed16fc'
            '90fff62b295aa2d517797af6da997a324612a3c9669883b220eaec0282531d20'
            'fb1fb33971be8d78ec542c502f0f6c93f1b67228692cb160c394ef239d94cf64')

build() {
  # Recipe chooses cmake via explicit PATH discovery, never inherited CMAKE.
  env -u CMAKE sh "$srcdir/configure.sh" "$srcdir/FreeRDP-$_commit" "$srcdir/build" || return 1
  python "$srcdir/check-contract.py" "$srcdir/build" "$srcdir/accepted-features.txt" || return 1
  cmake --build "$srcdir/build" --parallel 2
}

check() {
  # Static only; no provider execution or host trust/device access.
  python "$srcdir/check-contract.py" "$srcdir/build" "$srcdir/accepted-features.txt" \
    "$srcdir/build/winpr/libwinpr/libwinpr3.so"
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build" || return 1
  ln -s xfreerdp "$pkgdir/usr/lib/omawin365/freerdp/bin/xfreerdp3" || return 1
  install -Dm644 "$srcdir/FreeRDP-$_commit/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE" || return 1
  install -Dm644 "$srcdir/uwac-NOTICES.txt" "$pkgdir/usr/share/licenses/$pkgname/uwac-NOTICES.txt"
}
