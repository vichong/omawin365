From 5b3adfff3bed4c7a18c023f01e110a07d4229c61 Mon Sep 17 00:00:00 2001
From: Armin Novak <armin.novak@thincast.com>
Date: Mon, 19 Oct 2026 09:02:51 +0200
Subject: [PATCH] [channels,client] add
 freerdp_generic_DVCPluginEntryWithOptions

Since the channel concurrency restrictions introduced with 3.32.2 we
have no proper way to create a channel that requires multiple
concurrent instances. With this new function we can pass optional flags
that can lift this restriction for selected channels.
---
 channels/client/generic_dynvc.c   | 110 +++++++++++++++++++++++++-----
 include/freerdp/client/channels.h |  36 ++++++++++
 2 files changed, 130 insertions(+), 16 deletions(-)

diff --git a/channels/client/generic_dynvc.c b/channels/client/generic_dynvc.c
index ecb60bee0047..476e71f3eb17 100644
--- a/channels/client/generic_dynvc.c
+++ b/channels/client/generic_dynvc.c
@@ -23,22 +23,77 @@
 
 #define TAG FREERDP_TAG("genericdynvc")
 
+static char magic[32] = "**GENERIC_DYNVC_PLUGIN_PRIVATE*";
+static const size_t maxPrivateOffset = 0x100000; /* 1MB should not be reached. */
+
+typedef struct
+{
+	char magic[32];
+	size_t pluginSize;
+	DWORD flags;
+	BOOL connected;
+} GENERIC_DYNVC_PLUGIN_PRIVATE;
+
+WINPR_ATTR_NODISCARD
+static GENERIC_DYNVC_PLUGIN_PRIVATE* getFromGeneric(GENERIC_DYNVC_PLUGIN* plugin)
+{
+	if (!plugin)
+		return nullptr;
+
+	/* We do not know the exact size used to allocate this struct (+ some channel custom data
+	 * afterward) but we know that the private segment starts with a certain magic.
+	 *
+	 * So search for the magic from the end of GENERIC_DYNVC_PLUGIN until found.
+	 */
+	char* ptr = (char*)(&plugin[1]);
+
+	size_t count = 0;
+	while (memcmp(ptr, magic, sizeof(magic)) != 0)
+	{
+		/* Skip all values that do not match the first element of the magic pattern.
+		 * faster than a full memcmp */
+		while (*ptr != magic[0])
+		{
+			ptr++;
+			count++;
+			if (count > maxPrivateOffset)
+			{
+				WLog_ERR(TAG,
+				         "Failed to find GENERIC_DYNVC_PLUGIN_PRIVATE offset in the first %" PRIuz
+				         " bytes after GENERIC_DYNVC_PLUGIN, giving up.",
+				         maxPrivateOffset);
+				return nullptr;
+			}
+		}
+	}
+	return WINPR_PACKED_ALIGN_CAST(GENERIC_DYNVC_PLUGIN_PRIVATE*, ptr);
+}
+
+WINPR_ATTR_NODISCARD
+static BOOL generic_connected_allow_multiple(GENERIC_DYNVC_PLUGIN* plugin)
+{
+	GENERIC_DYNVC_PLUGIN_PRIVATE* priv = getFromGeneric(plugin);
+	if (!priv)
+		return FALSE;
+	return (priv->flags & GENERIC_CHANNEL_ENTRY_OPTION_MULTI_INSTANCE) != 0;
+}
+
 static BOOL generic_update_connected_state(GENERIC_DYNVC_PLUGIN* plugin, BOOL val)
 {
-	if (!plugin || !plugin->dynvc_name)
+	GENERIC_DYNVC_PLUGIN_PRIVATE* priv = getFromGeneric(plugin);
+	if (!priv)
 		return FALSE;
-	const size_t len = strlen(plugin->dynvc_name);
-	plugin->dynvc_name[len + 1] = (char)val;
+	priv->connected = val;
 	return TRUE;
 }
 
 WINPR_ATTR_NODISCARD
 static BOOL generic_get_connected_state(GENERIC_DYNVC_PLUGIN* plugin)
 {
-	if (!plugin || !plugin->dynvc_name)
+	GENERIC_DYNVC_PLUGIN_PRIVATE* priv = getFromGeneric(plugin);
+	if (!priv)
 		return FALSE;
-	const size_t len = strlen(plugin->dynvc_name);
-	return plugin->dynvc_name[len + 1];
+	return priv->connected;
 }
 
 static UINT generic_on_close(IWTSVirtualChannelCallback* pChannelCallback)
@@ -74,7 +129,7 @@ static UINT generic_on_new_channel_connection(IWTSListenerCallback* pListenerCal
 	GENERIC_DYNVC_PLUGIN* plugin = (GENERIC_DYNVC_PLUGIN*)listener_callback->plugin;
 	WLog_Print(plugin->log, WLOG_TRACE, "...");
 
-	if (generic_get_connected_state(plugin))
+	if (!generic_connected_allow_multiple(plugin) && generic_get_connected_state(plugin))
 	{
 		WLog_Print(plugin->log, WLOG_ERROR, "Channel already connected, terminating.");
 		return ERROR_DEVICE_ALREADY_ATTACHED;
@@ -202,27 +257,54 @@ UINT freerdp_generic_DVCPluginEntry(IDRDYNVC_ENTRY_POINTS* pEntryPoints, const c
                                     DYNVC_PLUGIN_INIT_FN initPluginFn,
                                     DYNVC_PLUGIN_TERMINATE_FN terminatePluginFn)
 {
-	GENERIC_DYNVC_PLUGIN* plugin = nullptr;
+	return freerdp_generic_DVCPluginEntryWithOptions(pEntryPoints, logTag, name, pluginSize,
+	                                                 channelCallbackSize, channel_callbacks,
+	                                                 initPluginFn, terminatePluginFn, 0);
+}
+
+UINT freerdp_generic_DVCPluginEntryWithOptions(
+    IDRDYNVC_ENTRY_POINTS* pEntryPoints, const char* logTag, const char* name, size_t pluginSize,
+    size_t channelCallbackSize, const IWTSVirtualChannelCallback* channel_callbacks,
+    DYNVC_PLUGIN_INIT_FN initPluginFn, DYNVC_PLUGIN_TERMINATE_FN terminatePluginFn, UINT32 flags)
+{
 	UINT error = CHANNEL_RC_INITIALIZATION_ERROR;
 
 	WINPR_ASSERT(pEntryPoints);
 	WINPR_ASSERT(pEntryPoints->GetPlugin);
 	WINPR_ASSERT(logTag);
 	WINPR_ASSERT(name);
-	WINPR_ASSERT(pluginSize >= sizeof(*plugin));
+	WINPR_ASSERT(pluginSize >= sizeof(GENERIC_DYNVC_PLUGIN));
 	WINPR_ASSERT(channelCallbackSize >= sizeof(GENERIC_CHANNEL_CALLBACK));
 
-	plugin = (GENERIC_DYNVC_PLUGIN*)pEntryPoints->GetPlugin(pEntryPoints, name);
+	GENERIC_DYNVC_PLUGIN* plugin =
+	    (GENERIC_DYNVC_PLUGIN*)pEntryPoints->GetPlugin(pEntryPoints, name);
 	if (plugin != nullptr)
 		return CHANNEL_RC_ALREADY_INITIALIZED;
 
-	plugin = (GENERIC_DYNVC_PLUGIN*)calloc(1, pluginSize);
+	/* Ensure 32 byte alignment.
+	 */
+	size_t size = pluginSize;
+	if ((size % 32) != 0)
+		size += 32 - size % 32;
+	size += sizeof(GENERIC_DYNVC_PLUGIN_PRIVATE);
+	plugin = (GENERIC_DYNVC_PLUGIN*)calloc(1, size);
 	if (!plugin)
 	{
 		WLog_ERR(TAG, "calloc failed!");
 		return CHANNEL_RC_NO_MEMORY;
 	}
 
+	BYTE* ptr = &(((BYTE*)plugin)[size - sizeof(GENERIC_DYNVC_PLUGIN_PRIVATE)]);
+	GENERIC_DYNVC_PLUGIN_PRIVATE* priv =
+	    WINPR_PACKED_ALIGN_CAST(GENERIC_DYNVC_PLUGIN_PRIVATE*, ptr);
+	if (!priv)
+		goto error;
+
+	WINPR_STATIC_ASSERT(sizeof(magic) == sizeof(priv->magic));
+	memcpy(priv->magic, magic, sizeof(priv->magic));
+	priv->pluginSize = pluginSize;
+	priv->flags = flags;
+
 	plugin->log = WLog_Get(logTag);
 	plugin->attached = TRUE;
 	plugin->channel_callbacks = channel_callbacks;
@@ -245,13 +327,9 @@ UINT freerdp_generic_DVCPluginEntry(IDRDYNVC_ENTRY_POINTS* pEntryPoints, const c
 			goto error;
 	}
 
-	/* Since we do not have a private struct append the connected state after the name of the
-	 * channel */
-	const size_t len = strlen(name);
-	plugin->dynvc_name = calloc(len + 2, sizeof(char));
+	plugin->dynvc_name = _strdup(name);
 	if (!plugin->dynvc_name)
 		goto error;
-	strncpy(plugin->dynvc_name, name, len);
 
 	error = pEntryPoints->RegisterPlugin(pEntryPoints, name, &plugin->iface);
 	if (error == CHANNEL_RC_OK)
diff --git a/include/freerdp/client/channels.h b/include/freerdp/client/channels.h
index e27ce43d0a89..a9e0464fea05 100644
--- a/include/freerdp/client/channels.h
+++ b/include/freerdp/client/channels.h
@@ -20,6 +20,8 @@
 #ifndef FREERDP_CHANNELS_CLIENT_H
 #define FREERDP_CHANNELS_CLIENT_H
 
+#include <winpr/wtypes.h>
+
 #include <freerdp/api.h>
 #include <freerdp/dvc.h>
 #include <freerdp/config.h>
@@ -31,6 +33,15 @@ extern "C"
 {
 #endif
 
+	/** @brief the supported options for \ref freerdp_generic_DVCPluginEntryWithOptions
+	 *  @since version 3.33.0
+	 */
+	typedef enum WINPR_C23_ENUM_TYPE(uint32_t)
+	{
+		GENERIC_CHANNEL_ENTRY_OPTION_NONE = 0,
+		GENERIC_CHANNEL_ENTRY_OPTION_MULTI_INSTANCE = 1
+	} GENERIC_CHANNEL_ENTRY_OPTIONS;
+
 	typedef struct
 	{
 		IWTSVirtualChannelCallback iface;
@@ -92,6 +103,31 @@ extern "C"
 	    size_t pluginSize, size_t channelCallbackSize,
 	    const IWTSVirtualChannelCallback* channel_callbacks, DYNVC_PLUGIN_INIT_FN initPluginFn,
 	    DYNVC_PLUGIN_TERMINATE_FN terminatePluginFn);
+
+	/** @brief Same as \ref freerdp_generic_DVCPluginEntry but allowing more fine grained
+	 * configuration.
+	 *
+	 *  @param pEntryPoints A pointer to the entry points to call, must not be NULL
+	 *  @param logTag A string to use to identify log messages, must not be NULL
+	 *  @param name The name of the channel, must not be NULL. Must not be reused for a second call.
+	 *  @param pluginSize The size of the plugin struct in bytes
+	 *  @param channelCallbackSize The size of the callback struct in bytes
+	 *  @param channel_callbacks A pointer to the channel callbacks to use, must not be NULL
+	 *  @param initPluginFn A function pointer called to initialize the channel, must not be NULL
+	 *  @param terminatePluginFn A function pointer called on channel termination, must not be NULL
+	 *  @param flags Configuration flags that can be passed. See \ref GENERIC_CHANNEL_ENTRY_OPTIONS
+	 * for flags available.
+	 *
+	 *  @return \ref CHANNEL_RC_OK for success, a specific failure code otherwise.
+	 *
+	 *  @since version 3.33.0
+	 */
+	WINPR_ATTR_NODISCARD
+	FREERDP_API UINT freerdp_generic_DVCPluginEntryWithOptions(
+	    IDRDYNVC_ENTRY_POINTS* pEntryPoints, const char* logTag, const char* name,
+	    size_t pluginSize, size_t channelCallbackSize,
+	    const IWTSVirtualChannelCallback* channel_callbacks, DYNVC_PLUGIN_INIT_FN initPluginFn,
+	    DYNVC_PLUGIN_TERMINATE_FN terminatePluginFn, UINT32 flags);
 #endif
 
 #ifdef __cplusplus
